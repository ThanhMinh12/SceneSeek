# clip uses the real PyTorch + Hugging Face CLIP model. deterministic is for tests only.
SCENESEEK_EMBEDDER=clip
SCENESEEK_CLIP_MODEL=openai/clip-vit-base-patch32
SCENESEEK_CLIP_REVISION=3d74acf9a28c67741b2f4f2ea7635f0aaf6f0268
SCENESEEK_DEVICE=auto
SCENESEEK_DATA_DIR=./data
SCENESEEK_FRAME_INTERVAL_SECONDS=2.0
SCENESEEK_MAX_UPLOAD_MB=1024
SCENESEEK_MAX_QUERY_MB=100
SCENESEEK_CORS_ORIGINS=http://localhost:5173
SCENESEEK_MAX_VIDEO_SECONDS=600
SCENESEEK_MAX_PENDING_JOBS=2
SCENESEEK_MAX_STORAGE_MB=2048
SCENESEEK_BROWSER_PLAYBACK=true
SCENESEEK_COOKIE_SECURE=false
# For HTTPS set COOKIE_SECURE=true. Keep /data/.session-secret persistent, or
# set SCENESEEK_SESSION_SECRET to a stable secret of at least 32 characters.

